<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>CONVEX_DEPLOYMENT_URL</key>
	<string>$(CONVEX_DEPLOYMENT_URL)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSCameraUsageDescription</key>
	<string>Victoria Kill Zone uses the rear camera to detect the opposing player and render the live duel view.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Victoria Kill Zone uses your foreground location to confirm that both players remain inside the active arena.</string>
	<key>NSLocationTemporaryUsageDescriptionDictionary</key>
	<dict>
		<key>VictoriaKillZoneArena</key>
		<string>Precise location is used during an active duel to evaluate the arena boundary.</string>
	</dict>
	<key>NSMicrophoneUsageDescription</key>
	<string>When you turn on Voice Fire, Victoria Kill Zone uses the microphone to listen for the phrase “pew pew.” Audio and transcripts are not stored by Victoria Kill Zone.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>When you turn on Voice Fire, Victoria Kill Zone uses speech recognition to recognize “pew pew” as an optional alternate trigger.</string>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UIRequiresFullScreen</key>
	<true/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
</dict>
</plist>
